<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- FocusGate's colors (same as Ui.kt) -->
    <color name="bg">#111317</color>
    <color name="card">#1D2025</color>
    <color name="text">#E8EAED</color>
    <color name="muted">#9AA0A6</color>
    <color name="accent">#8AB4F8</color>

    <style name="FocusGate" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:alertDialogTheme">@style/FocusGate.Dialog</item>
    </style>

    <!-- every AlertDialog: dark card, rounded corners, blue buttons and checkmarks -->
    <style name="FocusGate.Dialog" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_bg</item>
        <item name="android:colorBackground">@color/card</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="android:textColorAlertDialogListItem">@color/text</item>
        <item name="android:buttonBarButtonStyle">@style/FocusGate.DialogButton</item>
    </style>

    <style name="FocusGate.DialogButton" parent="@android:style/Widget.Material.Button.Borderless.Colored">
        <item name="android:textColor">@color/accent</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
    </style>
</resources>
